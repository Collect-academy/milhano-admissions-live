      ],
      "parameters": {
        "jsCode": "const old=$('Supabase | Dispatched Attempts').all().flatMap(i=>Array.isArray(i.json)?i.json:Array.isArray(i.json?.data)?i.json.data:[i.json]);\nconst whatsapp=$input.all().flatMap(i=>Array.isArray(i.json)?i.json:Array.isArray(i.json?.data)?i.json.data:[i.json])\n .map(i=>({...i,campaign_id:null,campaign_member_id:null,source:'wa_one_shot'}));\nconst set=new Set();\nreturn [...old,...whatsapp].filter(x=>x.status==='dispatched'&&/^conv_[A-Za-z0-9]+$/.test(String(x.conversation_id??'')))\n .filter(x=>{if(set.has(x.conversation_id))return false;set.add(x.conversation_id);return true})\n .map(x=>({json:x}));"
      }
    },
