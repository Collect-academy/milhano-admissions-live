      "name": "Verify | GHL Identity and Note",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -720,
        280
      ],
      "parameters": {
        "jsCode": "\nconst x=$('Normalize | Verified Post Call Request').first().json;\nconst obj=$('GHL | Get Current Opportunity').first().json??{};\nconst opp=obj.opportunity??obj;\nconst noteResult=$input.first().json??{};\nconst notes=Array.isArray(noteResult.notes)?noteResult.notes:Array.isArray(noteResult.data?.notes)?noteResult.data.notes:[];\nconst validOpp=String(opp.id??'')===x.ghl_opportunity_id\n && String(opp.contactId??opp.contact?.id??'')===x.ghl_contact_id\n && String(opp.pipelineId??'')==='GYqHbZyWUxxc3K03efVT'\n && String(opp.status??'').toLowerCase()==='open';\nconst validNote=notes.some(n=>String(n.id??'')===x.ghl_note_id\n && String(n.body??n.note??'').includes(x.conversation_id));\nif(!validOpp||!validNote)return [];\nreturn [{json:{...x,stage_id:String(opp.pipelineStageId??''),\n pipeline_id:String(opp.pipelineId??''),identity_verified:true,note_verified:true}}];\n"
      }
