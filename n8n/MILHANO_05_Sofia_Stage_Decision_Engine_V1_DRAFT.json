      "parameters": {
        "jsCode": "\nconst req=$input.first().json,b=req.body??req;\nconst clean=(v)=>String(v??'').trim();\nconst x={\n conversation_id:clean(b.conversation_id),\n ghl_contact_id:clean(b.ghl_contact_id),\n ghl_opportunity_id:clean(b.ghl_opportunity_id),\n ghl_note_id:clean(b.ghl_note_id),\n note_saved:b.note_saved===true\n};\nif(!/^conv_[a-zA-Z0-9]+$/.test(x.conversation_id)\n || !/^[a-zA-Z0-9_-]{8,64}$/.test(x.ghl_contact_id)\n || !/^[a-zA-Z0-9_-]{8,64}$/.test(x.ghl_opportunity_id)\n || !x.ghl_note_id || !x.note_saved)return [];\nreturn [{json:x}];\n"
      }
