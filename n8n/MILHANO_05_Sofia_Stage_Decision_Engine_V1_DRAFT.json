        "jsCode": "\nconst STAGE_WRITES_ENABLED=false; // Must match Safety Gate configuration.\nif(STAGE_WRITES_ENABLED)return [];\nconst d=$('Prepare | Stage Decision Audit').first().json;\nconst action=String(d.decision?.action??'review');\nconst next=action==='retry'?'retry':action==='skip'?'skip':'review';\nreturn [{json:{p_conversation_id:d.conversation_id,p_decision:next,p_stage_applied:false,p_target_stage_id:null}}];\n"
