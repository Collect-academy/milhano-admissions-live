        "jsCode": "\nconst p=$('Prepare | Stage Decision Audit').first().json;\nconst o=$input.first().json?.opportunity??$input.first().json??{};\nif(String(o.id??'')!==p.ghl_opportunity_id\n ||String(o.contactId??'')!==p.ghl_contact_id\n ||String(o.pipelineId??'')!==p.pipeline_id\n ||String(o.pipelineStageId??'')!==p.stage_id\n ||String(o.status??'').toLowerCase()!=='open'\n ||String(p.decision.target_stage_id??'')==='')return [];\nreturn [{json:p}];\n"
