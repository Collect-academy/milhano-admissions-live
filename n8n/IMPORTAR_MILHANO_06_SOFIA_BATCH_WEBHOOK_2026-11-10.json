        "jsCode": "const body=$input.first().json?.body??{};\nif(body.source!=='sofia_supabase_cron')throw new Error('SCHEDULER_SOURCE_INVALID');\nconst limit=Number(body.limit??0);\nif(!Number.isInteger(limit)||limit<1||limit>200)throw new Error('SCHEDULER_LIMIT_INVALID');\nreturn [{json:{p_limit:limit}}];"
