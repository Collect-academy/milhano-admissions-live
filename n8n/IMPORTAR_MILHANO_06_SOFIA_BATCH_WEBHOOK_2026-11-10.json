    {
      "id": "2a79a0ec-0ac2-4c5d-9766-5a9601aa584d",
      "name": "Verify | Live GHL Eligibility",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -410,
        160
      ],
      "parameters": {
        "jsCode": "const claims=$('Normalize | Claim').all(),opps=$('GHL | Recheck Opportunity').all(),contacts=$input.all();\nif(claims.length!==opps.length||claims.length!==contacts.length)throw new Error('GHL_RESULT_COUNT_MISMATCH_MANUAL_REVIEW');\nreturn claims.map((item,i)=>{\n const c=item.json,or=opps[i]?.json??{},cr=contacts[i]?.json??{},o=or.opportunity??or,ct=cr.contact??cr;\n let reason=null;\n if(or.error||cr.error||Number(or.statusCode)>=400||Number(cr.statusCode)>=400)reason='GHL_READ_FAILED';\n else if(String(o.id??'')!==c.opportunity_id||String(o.contactId??'')!==c.contact_id)reason='OPPORTUNITY_CONTACT_MISMATCH';\n else if(String(o.pipelineId??'')!=='GYqHbZyWUxxc3K03efVT')reason='PIPELINE_CHANGED';\n else if(String(o.pipelineStageId??'')!==String(c.expected_stage_id??''))reason='STAGE_CHANGED';\n else if(String(o.status??'').toLowerCase()!=='open')reason='OPPORTUNITY_NOT_OPEN';\n else if(String(ct.id??'')!==c.contact_id)reason='CONTACT_MISMATCH';\n else if(ct.dnd===true)reason='CONTACT_DND';\n else if(String(ct.dndSettings?.call?.status??'').toLowerCase()==='active'||\n         String(ct.dndSettings?.whatsApp?.status??ct.dndSettings?.whatsapp?.status??'').toLowerCase()==='active')reason='CHANNEL_DND';\n else if(!String(ct.phone??'').trim())reason='PHONE_MISSING';\n return {json:{...c,eligible:reason===null,reason}};\n});",
        "mode": "runOnceForAllItems"
      }
    },
