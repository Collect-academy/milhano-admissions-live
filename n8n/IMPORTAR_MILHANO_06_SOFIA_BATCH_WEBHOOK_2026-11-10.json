        "jsCode": "const raw=$input.all().flatMap(x=>Array.isArray(x.json)?x.json:Array.isArray(x.json?.data)?x.json.data:[x.json]);\nreturn raw.filter(a=>a&&a.member_id&&a.lease_token&&a.contact_id&&a.opportunity_id&&a.dispatch_key)\n.map(a=>({json:a}));"
