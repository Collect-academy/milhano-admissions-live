    {
      "id": "8dc030e2-1e73-4b99-88b4-5651d2dcbf3f",
      "name": "Prepare | Feed Outcome",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        20
      ],
      "parameters": {
        "jsCode": "const responses=$input.all(),eligible=$('Verify | Live GHL Eligibility').all().filter(x=>x.json.eligible);\nif(responses.length!==eligible.length)throw new Error('WF03_RESULT_COUNT_MISMATCH: manual review of claimed items required');\nreturn eligible.map((item,i)=>{\n const claim=item.json,raw=responses[i]?.json??{},a=raw.webhook_response??raw.result?.webhook_response??raw.result??raw.data?.webhook_response??raw.data??raw;\n const id=String(a.conversation_id??a.conversationId??'');\n const accepted=!raw.error&&a.success===true&&String(a.status)==='DISPATCHED'&&/^conv_[A-Za-z0-9]+$/.test(id);\n const blocked=!raw.error&&a.success===false&&['BLOCKED','INVALID_TRIGGER','DUPLICATE'].includes(String(a.status));\n return {json:{p_member_id:claim.member_id,p_lease_token:claim.lease_token,\n   p_status:accepted?'dispatched':blocked?'excluded':'review',\n   p_conversation_id:accepted?id:null,p_error_code:accepted?null:blocked?'WF03_BLOCKED':'UNVERIFIED_FEED_RESULT'}};\n});",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "ea207b5c-0627-4d4d-b86a-514bb36bdfda",
      "name": "Prepare | Exclusion",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        20,
        310
      ],
      "parameters": {
        "jsCode": "return $input.all().map(x=>({json:{\n p_member_id:x.json.member_id,p_lease_token:x.json.lease_token,\n p_status:'excluded',p_conversation_id:null,p_error_code:x.json.reason??'GHL_ELIGIBILITY_FAILED'\n}}));",
        "mode": "runOnceForAllItems"
      }
    },
