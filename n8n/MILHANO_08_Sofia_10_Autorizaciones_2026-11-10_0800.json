      "parameters": {
        "jsCode": "const found=$input.all(),eligible=$('Verify | Live New Lead Opportunity').all(),out=[],seenContacts=new Set(),seenPhones=new Set();\nfor(let i=0;i<found.length;i++){\n const raw=found[i].json??{},c=raw.contact??raw,x=eligible[i]?.json??{};\n if(String(c.id??'')!==String(x.ghl_contact_id??''))continue;\n if(c.locationId&&String(c.locationId)!=='ZzRtp9n8n76ARy99VzJc')continue;\n if(c.dnd===true)continue;\n const ds=c.dndSettings??{};\n if(ds.call?.status==='active'||ds.whatsApp?.status==='active'||ds.whatsapp?.status==='active')continue;\n const phone=String(c.phone??'').replace(/\\D/g,'');\n if(phone.length<10||phone.length>15||(!phone.startsWith('52')&&!phone.startsWith('1')))continue;\n if(seenContacts.has(x.ghl_contact_id)||seenPhones.has(phone))continue;\n seenContacts.add(x.ghl_contact_id);seenPhones.add(phone);\n out.push(x);\n}\nout.sort((a,b)=>a.created_at.localeCompare(b.created_at)||a.ghl_opportunity_id.localeCompare(b.ghl_opportunity_id));\nconst ten=out.slice(0,10);\nif(ten.length!==10)throw new Error('FEWER_THAN_10_VERIFIED_GHL_CONTACTS_NO_SEND');\nreturn ten.map(x=>({json:x}));"
      }
