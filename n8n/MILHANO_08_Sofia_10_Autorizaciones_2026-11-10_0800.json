        "jsCode": "const rows=$input.all().flatMap(x=>Array.isArray(x.json)?x.json:Array.isArray(x.json?.data)?x.json.data:[x.json]);\nconst valid=rows.filter(x=>x.ghl_opportunity_id&&x.ghl_contact_id&&x.created_at)\n .sort((a,b)=>a.created_at.localeCompare(b.created_at)||a.ghl_opportunity_id.localeCompare(b.ghl_opportunity_id));\nif(valid.length<10)throw new Error('LESS_THAN_10_PRELIMINARY_CANDIDATES');\nreturn valid.map(x=>({json:x}));"
