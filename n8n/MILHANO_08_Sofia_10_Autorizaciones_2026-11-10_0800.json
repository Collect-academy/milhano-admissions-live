      "parameters": {
        "jsCode": "const original=$('Expand | Candidate Pool').all(),responses=$input.all(),out=[];\nfor(let i=0;i<responses.length;i++){\n const oRaw=responses[i].json??{},o=oRaw.opportunity??oRaw,x=original[i]?.json??{};\n if(String(o.id??'')!==String(x.ghl_opportunity_id??''))continue;\n if(String(o.contactId??o.contact?.id??'')!==String(x.ghl_contact_id??''))continue;\n if(String(o.pipelineId??'')!=='GYqHbZyWUxxc3K03efVT')continue;\n if(String(o.pipelineStageId??'')!=='24a91c8c-c38a-48f9-934a-a5a1b5cb8fa0')continue;\n if(String(o.status??'').toLowerCase()!=='open')continue;\n out.push({json:x});\n}\nif(out.length<10)throw new Error('LESS_THAN_10_LIVE_OPPORTUNITIES');\nreturn out;"
