      "parameters": {
        "jsCode": "\nconst c=$('Normalize | Claim').first().json;\nconst oRaw=$('GHL | Recheck Opportunity').first().json??{},o=oRaw.opportunity??oRaw;\nconst cRaw=$input.first().json??{},ct=cRaw.contact??cRaw;\nlet reason=null;\nif(String(o.id??'')!==c.opportunity_id||String(o.contactId??'')!==c.contact_id)reason='OPPORTUNITY_IDENTITY_MISMATCH';\nelse if(String(o.pipelineId??'')!=='GYqHbZyWUxxc3K03efVT')reason='PIPELINE_CHANGED';\nelse if(String(o.pipelineStageId??'')!==String(c.expected_stage_id??''))reason='STAGE_CHANGED';\nelse if(String(o.status??'').toLowerCase()!=='open')reason='OPPORTUNITY_NOT_OPEN';\nelse if(String(ct.id??'')!==c.contact_id)reason='CONTACT_IDENTITY_MISMATCH';\nelse if(ct.dnd!==false)reason='CONTACT_DND_NOT_EXPLICITLY_FALSE';\nelse if(ct.dndSettings?.Call===true||ct.dndSettings?.call===true)reason='CALL_DND';\nelse if(!String(ct.phone??'').trim())reason='PHONE_MISSING';\nreturn [{json:{...c,eligible:reason===null,reason}}];\n"
      }
