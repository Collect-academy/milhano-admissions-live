# Project URL: Supabase > Connect
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase > Settings > API Keys > Secret keys
# NEVER prefix this variable with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Temporary dashboard protection.
DASHBOARD_USERNAME=milhano
DASHBOARD_PASSWORD=replace-with-a-long-password

# Admissions V2 manual refresh button -> n8n Workflow 09 V4.
# Use the production webhook URL after activating the workflow.
MILHANO_N8N_REFRESH_WEBHOOK_URL=https://YOUR_N8N_HOST/webhook/milhano-dashboard-refresh-v2
MILHANO_N8N_REFRESH_KEY=REPLACE_WITH_V2_REFRESH_SECRET
